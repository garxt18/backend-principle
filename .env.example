# Copy to .env (never commit .env). docker compose reads it automatically.
DB_PASSWORD=change-me
# Generate with:  openssl rand -base64 48
APP_JWT_SECRET=replace-with-a-long-random-string
APP_ADMIN_EMAIL=you@example.com
APP_ADMIN_PASSWORD=choose-a-long-admin-password
# Only for docker-compose.prod.yml (your domain, e.g. learn.example.com)
DOMAIN=

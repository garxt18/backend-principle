# Copy to .env (never commit .env). docker compose reads it automatically.
DB_PASSWORD=change-me
# Generate with:  openssl rand -base64 48
APP_JWT_SECRET=replace-with-a-long-random-string
APP_ADMIN_EMAIL=you@example.com
APP_ADMIN_PASSWORD=choose-a-long-admin-password
# Optional "Continue with Google" (docs/DEPLOYMENT.md -> Google sign-in). Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public address of the site, used for Google's redirect URL (e.g. https://learn.example.com or http://localhost:8080)
APP_PUBLIC_URL=
# Only for docker-compose.prod.yml (your domain, e.g. learn.example.com)
DOMAIN=
